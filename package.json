{
  "name": "my-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "android": "adb wait-for-device && adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:3005 tcp:3005 && adb reverse tcp:5000 tcp:5000 && expo run:android",
    "android:release": "expo run:android --variant release && adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082",
    "android:relaunch": "adb shell am force-stop com.anonymous.myapp && adb shell monkey -p com.anonymous.myapp -c android.intent.category.LAUNCHER 1",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:relaunch": "xcrun simctl terminate booted com.anonymous.myapp || true && xcrun simctl launch booted com.anonymous.myapp",
    "ios:open": "open ios/myapp.xcworkspace",
    "ios:pod-install": "cd ios && pod install && cd ..",
    "web": "expo start --web",
    "test:e2e": "node ./scripts/run-e2e-android.mjs",
    "test:walletconnect": "node --experimental-loader ./__tests__/helpers/rn-stub-loader.mjs --experimental-strip-types --test __tests__/walletconnect.test.mjs __tests__/walletconnect-runtime.test.mjs __tests__/webrgb-integration.test.mjs __tests__/wallet-storage.test.mjs",
    "lint": "expo lint",
    "clean:android": "rm -rf android/app/build android/build android/.gradle android/app/.cxx",
    "clean:ios": "rm -rf ios/build ios/DerivedData && (xcodebuild clean -workspace ios/myapp.xcworkspace -scheme myapp 2>/dev/null || true)",
    "clean:metro": "rm -rf .metro-health-check* /tmp/metro-* /tmp/haste-*",
    "clean:expo": "rm -rf .expo",
    "clean": "npm run clean:android && npm run clean:ios && npm run clean:metro"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reown/walletkit": "1.6.0",
    "@utexo/rgb-sdk-rn": "1.0.0-beta.34",
    "@utexo/webrgb": "^0.1.0",
    "@utexo/webrgb-walletconnect": "^0.1.0",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/react-native-compat": "2.25.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.25",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "^6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@scure/bip39": "^2.0.1",
    "@types/node": "^24.10.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "typescript": "~5.9.2"
  },
  "private": true
}
