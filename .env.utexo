# UTEXO network credentials — copy to .env.utexo.local and fill in real values.
# .env.utexo.local is gitignored and safe for secrets.

EXPO_PUBLIC_UTEXO_BITCOIND_RPC_USERNAME=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_PASSWORD=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_HOST=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_PORT=38332
EXPO_PUBLIC_UTEXO_INDEXER_URL=https://dev.esplora-01.mint.utexo.com
EXPO_PUBLIC_UTEXO_PROXY_ENDPOINT=rpcs://rgb-proxy.utexo.com/json-rpc
# VSS (optional) — set to enable encrypted cloud backup/restore in the VSS flow
EXPO_PUBLIC_UTEXO_VSS_URL=https://vss-server.utexo.com/vss
