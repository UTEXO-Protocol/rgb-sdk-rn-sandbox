BITCOIN_NODE_ENDPOINT=http://127.0.0.1:5000/execute
EXPO_PUBLIC_RLN_VSS_URL=http://127.0.0.1:8081/vss

EXPO_PUBLIC_UTEXO_BITCOIND_RPC_USERNAME=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_PASSWORD=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_HOST=
EXPO_PUBLIC_UTEXO_BITCOIND_RPC_PORT=38332
EXPO_PUBLIC_UTEXO_INDEXER_URL=https://esplora-api.utexo.com
EXPO_PUBLIC_UTEXO_PROXY_ENDPOINT=rpcs://rgb-proxy-utexo.utexo.com/json-rpc
EXPO_PUBLIC_FAUCET_NODE_URL=
EXPO_PUBLIC_UTEXO_VSS_URL=https://vss-server.utexo.com/vss

# RGB Lib / Utexo signet (separate from the RLN Wallet tab).
EXPO_PUBLIC_RGB_LIB_UTEXO_INDEXER_URL=https://esplora-api.utexo.com
# RGB Lib proxy implementing protocol 1.0 (separate from the RLN proxy).
EXPO_PUBLIC_RGB_LIB_UTEXO_PROXY_ENDPOINT=rpcs://rgb-proxy.dev.utexo.com/json-rpc
# Required to receive BFA mints from Arbitrum (chain 42161).
# Add an entry for every source EVM chain used by the bridge.
EXPO_PUBLIC_RGB_LIB_UTEXO_EVM_RPC_URLS={"42161":"https://arb1.arbitrum.io/rpc"}
